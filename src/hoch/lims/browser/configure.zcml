<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone">

    <!-- package includes -->
    <include package=".analyses"/>
    <include package=".theme"/>
    <include package=".viewlets"/>
    <include package=".content"/>
    <include package=".worksheets"/>

    <!-- Static directory for js, css and image resources -->
    <plone:static
        directory="static"
        type="plone"
        name="hoch.lims.static" />
    
    <!-- Patient Controlpanel -->
    <browser:page
      name="hochlims-controlpanel"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.HochControlPanelView"
      permission="hoch.lims.permissions.ManageMarketingAuthorizations"
      layer="hoch.lims.interfaces.IHochLims"
      />

    <plone:static
        name="hoch"
        directory="worksheets/templates/print"
        type="worksheets"
    />

    <browser:page
        name="print"
        for="bika.lims.interfaces.IWorksheet"
        class=".printview.PrintView"
        permission="senaite.core.permissions.ViewResults"
        layer="hoch.lims.interfaces.IHochLims"
    />

    <!-- Batch folder listing: adds ExpirationDate and BatchSize columns -->
    <browser:page
        name="base_view"
        for="bika.lims.interfaces.IBatchFolder"
        class=".batch.batches.BatchFolderContentsView"
        permission="cmf.ListFolderContents"
        layer="hoch.lims.interfaces.IHochLims"
    />

    <!-- Batch workflow after-script handlers -->
    <browser:page
        name="hoch_batch_after_release"
        for="bika.lims.interfaces.IBatch"
        class=".batch.workflow.BatchAfterRelease"
        permission="zope2.View"
        layer="hoch.lims.interfaces.IHochLims"
    />

</configure>
