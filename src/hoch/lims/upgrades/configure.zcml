<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="hoch.lims">

  <genericsetup:upgradeStep
      title="Enable the HOCH OOS workflow"
      description="Connect OOS workflow guards for SENAITE 2.x"
      source="1000"
      destination="1001"
      handler="hoch.lims.upgrades.v1001.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Install Batch and OOS role permissions"
      description="Apply the approved workflow role matrix"
      source="1001"
      destination="1002"
      handler="hoch.lims.upgrades.v1002.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Restore LabClerk worksheet permissions"
      description="Preserve LabClerk access after SENAITE recalculations"
      source="1002"
      destination="1003"
      handler="hoch.lims.upgrades.v1003.upgrade"
      profile="hoch.lims:default"
      />

</configure>
