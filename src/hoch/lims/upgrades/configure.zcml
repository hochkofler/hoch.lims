<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="hoch.lims">

  <genericsetup:upgradeStep
      title="Enable the HOCH OOS workflow"
      description="Connect OOS workflow guards for SENAITE 2.x"
      source="1000"
      destination="1001"
      handler="hoch.lims.upgrades.v1001.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Install Batch and OOS role permissions"
      description="Apply the approved workflow role matrix"
      source="1001"
      destination="1002"
      handler="hoch.lims.upgrades.v1002.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Restore LabClerk worksheet permissions"
      description="Preserve LabClerk access after SENAITE recalculations"
      source="1002"
      destination="1003"
      handler="hoch.lims.upgrades.v1003.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Restore global LabClerk worksheet permissions"
      description="Allow worksheet creation from the Samples view"
      source="1003"
      destination="1004"
      handler="hoch.lims.upgrades.v1004.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Re-sync AnalysisService and Analysis interim flags"
      description="Restore interims hidden by an incomplete service record"
      source="1004"
      destination="1005"
      handler="hoch.lims.upgrades.v1005.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Enable Dynamic Calculation rules"
      description="Add the dynamic rules behavior to Calculation"
      source="1005"
      destination="1006"
      handler="hoch.lims.upgrades.v1006.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Enable Dynamic exclusion on analysis categories"
      description="Add the dynamic exclusion behavior to AnalysisCategory"
      source="1006"
      destination="1007"
      handler="hoch.lims.upgrades.v1007.upgrade"
      profile="hoch.lims:default"
      />

  <genericsetup:upgradeStep
      title="Enable the HPLC calculation model"
      description="HPLC model on Calculation, HPLC parameters on SampleMatrix"
      source="1007"
      destination="1008"
      handler="hoch.lims.upgrades.v1008.upgrade"
      profile="hoch.lims:default"
      />

</configure>
