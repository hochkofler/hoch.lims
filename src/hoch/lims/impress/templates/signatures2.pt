<tal:signatures
  tal:define="title python: options.get('title', 'RESPONSABLES');
              laboratory python:view.laboratory;
              title_number python: options.get('title_number', 6);
              sample python: options.get('sample', None);
              analyses python: options.get('analyses', []);
              managers python: sample.getManagers() if sample else [];
              verificators python: [a.getVerificators() for a in analyses if a.getVerificators()];
              verificators_user_names python:view.uniquify_items(verificators);
              analysts_user_names python:view.uniquify_items(a.getAnalyst() for a in analyses);
              verficators python: [managers[0].getContactByUsername(u) for u in verificators_user_names if managers[0].getContactByUsername(u)];
              analysts python: [managers[0].getContactByUsername(u) for u in analysts_user_names if managers[0].getContactByUsername(u)];
              analysts python: batch.getAnalyst();
              current_user_name python: view.current_user.get('username', '');
              supervisor_user python: laboratory.get('Supervisor');
              publisher_user python: managers[0].getContactByUsername(current_user_name);
              user_signatures python: [{'users': analysts,'role':'Analizado por'}, 
                                        {'users': verficators, 'role':'Verificado por'}, 
                                        {'users':[supervisor_user], 'role':'Resp. del laboratorio'}];">
  <div class="font-size-120 font-weight-bold"
        tal:content="python: str(title_number) + '.- ' + title"></div>
  <span>Analysts</span>
  <span tal:content="analysts"></span>
  <table class="table table-sm table-condensed" style="width: 100%; table-layout: fixed !important;">
    <tr>
      <tal:role tal:repeat="role user_signatures">
        <tal:user repeat="user python:role.get('users')">
          <td style="border:none; max-width: 30px; vertical-align: top;">
            <div tal:condition="python: user and user == role.get('users')[0]" tal:content="python:role.get('role')"
              class="font-weight-bold colon-after">
            </div>
            <div>
              <img tal:condition="user/getSignature" tal:attributes="src string:${manager/absolute_url}/Signature"
                style="height:75px" />
            </div>
            <div class="font-weight-bold">
              <span tal:content="user/Salutation|nothing"></span>
              <span tal:condition="user/Salutation">&nbsp;</span>
              <span tal:content="user/getFullname"></span>
            </div>
            <div>
              <span tal:content="user/JobTitle"></span>
            </div>
            <div>
              <span tal:content="user/DefaultDepartment/title|nothing"></span>
            </div>
            <div>
              <span tal:content="user/getUsername"></span>
            </div>
          </td>
        </tal:user>
      </tal:role>
    </tr>
  </table>
</tal:signatures>