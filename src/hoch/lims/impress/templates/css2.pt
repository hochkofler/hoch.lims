<tal:t define="report_options python:options.get('report_options', {});
attachments_per_row python:int(report_options.get('attachments_per_row', 2));
attachments_per_row python:attachments_per_row < 1 and 1 or attachments_per_row;
page_width options/page_width|nothing;
page_height options/page_height|nothing;
content_width options/content_width|nothing;
content_height options/content_height|nothing;" 
i18n:domain="hoch.lims">

<style type="text/css">
  /* --- Global Reset & Typography --- */
  .report {
    font-family: Calibri, Arial, Helvetica, sans-serif;
    font-size: 7pt;
    line-height: 1.3;
    color: #000;
  }

  .report * {
    box-sizing: border-box;
  }

  .report h1, .report h2, .report h3 {
    margin: 0 0 10px 0;
    padding: 0;
    font-weight: bold;
  }

  .report table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 10px;
  }

  /* --- Page Layout --- */
  @page {
    margin: 20mm;
    @top-center { content: element(header); }
    @bottom-center { content: element(footer); }
  }

  .page-break {
    page-break-before: always;
  }
  
  .keep-together {
    page-break-inside: avoid;
  }

  /* --- Generic Utilities --- */
  .text-center { text-align: center; }
  .text-right { text-align: right; }
  .text-left { text-align: left; }
  .font-bold { font-weight: bold; }
  .text-danger { color: red; }
  .w-100 { width: 100%; }
  
  /* --- Section 1: General Data --- */
  .data-table th, .data-table td {
    border: 1px solid #000;
    padding: 1px 4px;
    vertical-align: top;
  }
  
  .data-table th {
    background-color: #f0f0f0;
    font-weight: bold;
    width: 20%;
  }

  /* --- Section 2: Results --- */
  .results-table {
    margin-top: 20px;
  }

  .results-table th {
    border: 1px solid #000;
    background-color: #333;
    color: #fff;
    padding: 5px;
    text-align: center;
  }

  .results-table td {
    border: 1px solid #000;
    padding: 1px 4px;
    vertical-align: top;
  }

  .results-table .category-row th {
    background-color: #e0e0e0;
    color: #000;
    text-align: left;
    padding-left: 10px;
  }

  .results-table .out-of-range {
    color: red;
    font-weight: bold;
  }

  /* --- Section 3: Comments & Verdict --- */
  .comments-section {
    border: 1px solid #000;
    padding: 5px 10px;
    margin-bottom: 15px;
    <!-- min-height: 50px; -->
  }

  .verdict-section {
    text-align: center;
    border: 2px solid #000;
    padding: 10px;
    margin-bottom: 5px;
    <!-- background-color: #f9f9f9; -->
  }
  
  .verdict-label {
    font-size: 10pt;
    font-weight: bold;
    display: block;
    margin-bottom: 5px;
  }

  .verdict-value {
    font-size: 14pt;
    font-weight: bold;
  }

  /* --- Section 4: Signatures --- */
  .signatures-table {
    margin-top: 30px;
    border: none;
  }

  .signatures-table td {
    border: none;
    padding: 10px;
    vertical-align: bottom;
    text-align: center;
    width: 33%; /* Default to 3 cols if likely */
  }

  .signature-box {
    display: block;
    min-height: 40px;
    border-bottom: 1px solid #000;
    margin-bottom: 5px;
  }
  
  .signature-img {
    max-height: 60px;
  }

  /* --- Dynamic Images (from original CSS) --- */
  <tal:block condition="python:content_width and content_height">
    <tal:block condition="python:all([content_width, content_height])"
       define="cw python:float(content_width); ch python:float(content_height);">
      .report .section-attachments img {
        max-width: <tal:t replace="python:'{:.2f}mm'.format(cw / attachments_per_row)" />;
        max-height: <tal:t replace="python:'{:.2f}mm'.format(ch * 0.75)" />;
      }
    </tal:block>
  </tal:block>
</style>
</tal:t>