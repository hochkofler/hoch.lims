<tal:report tal:define="collection python:view.collection;
                     laboratory python:view.laboratory;
                     analyses python: view.get_analyses_by(collection);
                     current_user python: view.current_user.get('username', '');
                     report_options python: options.get('report_options', {});
                     show_conditions python: bool(report_options.get('show_conditions', True));
                     cert_id python: view.get_coa_number();
                     model python: view.model;
                     model_summary python: collection[0];
                     batch python: model_summary.getBatch();
                     product model_summary/Batch/Product;
                     mktauth product/MarketingAuthorization;
                     analysts_user_names python: view.uniquify_items(reduce(lambda a1, a2: a1+a2, map(lambda m: m.getAnalysts(), collection)));
                     supervisor_user python: laboratory.get('Supervisor');
                     analysts python: [view.getContactByUsername(u) for u in analysts_user_names if view.getContactByUsername(u)];
                     supervisor python: [supervisor_user] if supervisor_user else [];
                     user_signatures python: [{'users': analysts, 'role': 'Analista de Control de Calidad'},
                                              {'users': supervisor, 'role': 'Jefe de Control de Calidad'}];
                     date_format string:%d-%m-%Y;
                     expire_format string:%m-%Y;
                     batch_expire python: batch.ExpirationDate.strftime(expire_format) if batch.ExpirationDate else '';
                     batch_manufacture python: batch.ManufactureDate.strftime(date_format) if batch.ManufactureDate else '';
                     analyses_by_category python: view.group_items_by('Category', analyses);
                     sorted_categories python: view.sort_items(analyses_by_category);
                     in_aceptable_range_coa python: all(not(model.is_out_of_range(analysis)) for analysis in analyses);
                     verified_date python: max([sample.getDateVerified() for sample in collection if sample.getDateVerified()]);
                     first_capture_date python: min([analysis.getResultCaptureDate() for analysis in analyses if analysis.getResultCaptureDate()]);
                     remarks python: [];">

  <!-- REPORT CONTROLS -->
  <tal:t replace="structure python:view.render_controls(context, **options)" />

  <!-- REPORT JS -->
  <tal:t replace="structure python:view.render_js(context, **options)" />

  <!-- REPORT CSS -->
  <tal:t replace="structure python:view.render_css(context, **options)" />

  <style type="text/css" media="print">
    /* Captura el título del sub-informe para el encabezado running, sin ocupar espacio */
    h1.page-title {
      string-set: title content();
      font-size: 0;
      line-height: 0;
      height: 0;
      margin: 0;
      padding: 0;
      overflow: hidden;
      display: block;
    }

    /* Numeración por defecto en todas las páginas */
    @page {
      @bottom-right {
        content: "Pág. " counter(page) " de " counter(pages);
        font-size: 8pt;
        margin-bottom: 10mm;
      }
    }

    /* Portada COA: sin numeración */
    .coa {
      page: coa;
    }
    @page coa {
      margin-top: 25mm !important;
      margin-bottom: 20mm !important;
      @bottom-right { content: " "; }
    }

    /* Sub-informes (HPLC, UC): encabezado con título del h1.page-title + numeración */
    .section-titration-micro {
      page: sub-report;
    }
    @page sub-report {
      @top-center {
        content: String(title);
        font-size: 9pt;
        margin-top: 10mm;
        white-space: pre;
      }
      @bottom-right {
        content: "Pág. " counter(page) " de " counter(pages);
        font-size: 8pt;
        margin-bottom: 10mm;
      }
    }
  </style>

  <!-- COA PAGE -->
  <div class="coa page-break-after">
    <div class="main-title">
      <span>Certificado de Control de Calidad - Producto Terminado</span>
    </div>

    <!-- SECTION 1: DATOS GENERALES -->
    <div class="section-general">
      <tal:t replace="structure python:view.render_product_data(context, mktauth=mktauth, product=product, cert_id=cert_id)" />
      <tal:t replace="structure python:view.render_coa_batch_data(context, batch=batch, mktauth=mktauth,
                        batch_manufacture=batch_manufacture, batch_expire=batch_expire,
                        first_capture_date=first_capture_date, date_format=date_format)" />
    </div>

    <!-- SECTION 2: RESULTADOS -->
    <tal:t replace="structure python:view.render_coa_results(context, sorted_categories=sorted_categories,
                      analyses_by_category=analyses_by_category, remarks=remarks)" />

    <!-- SECTION 3: OBSERVACIONES Y DICTAMEN -->
    <tal:t replace="structure python:view.render_coa_verdict(context, in_aceptable_range_coa=in_aceptable_range_coa,
                      remarks=remarks, verified_date=verified_date, date_format=date_format)" />

    <!-- SECTION 4: FIRMAS -->
    <tal:t replace="structure python:view.render_coa_signatures(context, user_signatures=user_signatures)" />
  </div>

  <!-- TITRATION HPLC REPORT -->
  <tal:t replace="structure python:view.render_titration_hplc(context, batch=batch, mktauth=mktauth)" />

  <!-- UC REPORT -->
  <tal:t replace="structure python:view.render_uc_report(context, batch=batch, mktauth=mktauth)" />

</tal:report>
