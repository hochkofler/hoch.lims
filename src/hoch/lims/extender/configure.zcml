<?xml version="1.0" encoding="utf-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:browser="http://namespaces.zope.org/browser">

    <include package=".behaviors" />

    <!-- Batch Schema Extender (AT) -->
    <adapter
    factory=".batch.BatchSchemaExtender"
    name="batch-extender"
    provides="archetypes.schemaextender.interfaces.ISchemaExtender"/>

    <adapter
      factory=".sample.SampleSchemaExtender"
      name="sample-extender"
      provides="archetypes.schemaextender.interfaces.ISchemaExtender"/>
    
    <adapter
      factory=".sample.SampleSchemaModifier"
      name="sample-modifier"
      provides="archetypes.schemaextender.interfaces.ISchemaModifier"/>

    <adapter
    factory=".variables_settings_vocabulary.DefaultVariablesSettingsVocabularyProvider"
    provides="hoch.lims.interfaces.IVariablesSettingsVocabularyProvider"
    for="zope.interface.Interface" />

    <adapter
    factory=".variables_settings_vocabulary.InstrumentVariablesVocabulary"
    provides="hoch.lims.interfaces.IVariablesSettingsVocabularyProvider"
    for="bika.lims.interfaces.IInstrument" />

    <adapter
    factory=".variables_settings_vocabulary.ReferenceSampleVariablesVocabulary"
    provides="hoch.lims.interfaces.IVariablesSettingsVocabularyProvider"
    for="bika.lims.interfaces.IReferenceSample"/>

<adapter
    factory=".variables_settings.VariablesSettingsSchemaExtender"
    name="variables settings extender"
    provides="archetypes.schemaextender.interfaces.ISchemaExtender"
    for="bika.lims.interfaces.IReferenceSample"
/>

<adapter
    factory=".variables_settings.VariablesSettingsSchemaExtender"
    name="variables settings extender"
    provides="archetypes.schemaextender.interfaces.ISchemaExtender"
    for="bika.lims.interfaces.IInstrument"
/>

    <plone:behavior
    for="senaite.core.interfaces.ISampleMatrix"
    name="samplematrix-extender"
    title="Custom SampleMatrix Fields"
    description="Add custom fields to SampleMatrix"
    provides=".samplematrix.ISampleMatrixSchemaExtender"
    factory=".samplematrix.SampleMatrixSchemaExtender"
    />

    <adapter
    factory=".idserver.IDServerVariablesAdapter"
    provides="bika.lims.interfaces.IIdServerVariables"
    for="*" />
    
</configure>