<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="hoch.lims">

  <include package="plone.behavior" file="meta.zcml"/>

  <plone:behavior
      name="hoch.lims.extender.behavior.variablestable"
      title="VariablesTable"
      description="Custom variables"
      provides=".variablestable.IVariablesTableBehavior"
      factory=".variablestable.VariablesTable"
      for="senaite.core.interfaces.ISampleMatrix" />
  
  <plone:behavior
      name="hoch.lims.extender.behavior.dynamiccalculation"
      title="DynamicCalculationRules"
      description="Rules to apply a calculation dynamically"
      provides=".dynamiccalculation.IDynamicCalculationRulesBehavior"
      factory=".dynamiccalculation.DynamicCalculationRules"
      for="senaite.core.interfaces.ICalculation" />

  <plone:behavior
      name="hoch.lims.extender.behavior.hplcmodel"
      title="HPLCModel"
      description="External standard HPLC calculation model"
      provides=".hplcmodel.IHPLCModelBehavior"
      factory=".hplcmodel.HPLCModel"
      for="senaite.core.interfaces.ICalculation" />

  <plone:behavior
      name="hoch.lims.extender.behavior.hplcparameters"
      title="HPLCParameters"
      description="HPLC parameters of the product"
      provides=".hplcmodel.IHPLCParametersBehavior"
      factory=".hplcmodel.HPLCParameters"
      for="senaite.core.interfaces.ISampleMatrix" />

  <plone:behavior
      name="hoch.lims.extender.behavior.dynamiccategory"
      title="DynamicCategory"
      description="Conditions under which the analyses are not performed"
      provides=".dynamiccategory.IDynamicCategoryBehavior"
      factory=".dynamiccategory.DynamicCategory"
      for="senaite.core.interfaces.IAnalysisCategory" />

  <subscriber
      for="senaite.core.interfaces.ISampleMatrix
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".variablestable.on_samplematrix_added" />

  <subscriber
      for="senaite.core.interfaces.ISampleMatrix
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".variablestable.on_samplematrix_modified" />
</configure>