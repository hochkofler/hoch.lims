<?xml version="1.0" encoding="utf-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:monkey="http://namespaces.plone.org/monkey"
    i18n_domain="hoch.lims">

    <monkey:patch
    description="Formated result"
    class="senaite.core.exportimport.setupdata.Sample_Templates"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.Import_sample_templates" />

    <monkey:patch
    description="Calculation interim fields"
    class="senaite.core.exportimport.setupdata.Calculations"
    original="get_interim_fields"
    ignoreOriginal="True"
    replacement=".setupdata.get_interim_fields" />

    <monkey:patch
    description="AnalysisService interim fields"
    class="senaite.core.exportimport.setupdata.Analysis_Services"
    original="load_interim_fields"
    ignoreOriginal="True"
    replacement=".setupdata.load_interim_fields" />

    <monkey:patch
    description="AnalysisService import"
    class="senaite.core.exportimport.setupdata.Analysis_Services"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.import_analysis_services" />

    <monkey:patch
    description="AnalysisSpects import"
    class="senaite.core.exportimport.setupdata.Analysis_Specifications"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.import_Analysis_Specifications" />

    <monkey:patch
    description="Sample matrices import"
    class="senaite.core.exportimport.setupdata.Sample_Matrices"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.import_samplematrices" />

    <monkey:patch
    description="AnalysisProfile import"
    class="senaite.core.exportimport.setupdata.Analysis_Profiles"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.import_analysis_profiles" />

    <monkey:patch
    description="AnalysisProfile load sampletypes"
    class="senaite.core.exportimport.setupdata.Analysis_Profiles"
    original="load_analysis_profile_sampletypes"
    ignoreOriginal="True"
    replacement=".setupdata.load_analysis_profile_sampletypes" />

    <monkey:patch
    description="AnalysisProfile load services"
    class="senaite.core.exportimport.setupdata.Analysis_Profiles"
    original="load_analysis_profile_services"
    ignoreOriginal="True"
    replacement=".setupdata.load_analysis_profile_services" />

    <monkey:patch
    description="Setup load setup get field value"
    class="senaite.core.exportimport.setupdata.Setup"
    original="get_field_value"
    ignoreOriginal="True"
    replacement=".setupdata.setup_get_field_value"/>

    <monkey:patch
    description="Setup to choice value"
    class="senaite.core.exportimport.setupdata.Setup"
    original="to_choice_value"
    ignoreOriginal="True"
    replacement=".setupdata.setup_to_choice_value"/>

    <monkey:patch
    description="Setup load setup analysis"
    class="senaite.core.exportimport.setupdata.Setup"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.setup_Import"/>

    <monkey:patch
    description="Unicode InstrumentType setup-data titles"
    class="senaite.core.exportimport.setupdata.Instrument_Types"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.import_instrument_types" />

    <monkey:patch
    description="Unicode SampleCondition setup-data titles"
    class="senaite.core.exportimport.setupdata.Sample_Conditions"
    original="Import"
    ignoreOriginal="True"
    replacement=".setupdata.import_sample_conditions" />

</configure>
