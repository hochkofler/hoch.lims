<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:monkey="http://namespaces.plone.org/monkey"
    i18n_domain="hoch.lims">

  <!-- Package includes -->
  <include package=".exportimport" />

  <monkey:patch
    description="Monkey patch for AnalysisRequest content"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getDestinationsVocabulary"
    ignoreOriginal="True"
    replacement=".analysisrequest.getDestinationsVocabulary" />

  <monkey:patch
    description="Monkey patch for AnalysisRequest process vocabulary"
    class="bika.lims.content.analysisrequest.AnalysisRequest"
    original="getProcessesVocabulary"
    ignoreOriginal="True"
    replacement=".analysisrequest.getProcessesVocabulary" />

  <monkey:patch
    description="Preserve service-level interim overrides (value, hidden, etc.)
                 when setCalculation merges Calculation interims with
                 AnalysisService interims."
    class="bika.lims.content.abstractanalysis.AbstractAnalysis"
    original="setCalculation"
    ignoreOriginal="False"
    replacement=".analysis.setCalculation" />

</configure>