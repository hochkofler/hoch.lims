<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="hoch.lims">

  <!-- Batch Guard Adapter for workflow transitions -->
  <adapter
      for="bika.lims.interfaces.IBatch"
      provides="bika.lims.interfaces.IGuardAdapter"
      factory=".batch.BatchGuardAdapter"
      name="hoch_batch_guard"
      />

  <!-- Analysis Guard Adapter: validates consumables before submit -->
  <adapter
      for="bika.lims.interfaces.IRoutineAnalysis"
      provides="bika.lims.interfaces.IGuardAdapter"
      factory=".analysis.AnalysisGuardAdapter"
      name="hoch_analysis_guard"
      />

  <!-- OOS Investigation Guard Adapter -->
  <adapter
      for="hoch.lims.interfaces.IOOSInvestigation"
      provides="bika.lims.interfaces.IGuardAdapter"
      factory=".oos.OOSInvestigationGuardAdapter"
      name="hoch_oos_guard"
      />

  <!-- OOS auto-detection: create investigation on submit/verify if OOS -->
  <subscriber
      for="bika.lims.interfaces.IRoutineAnalysis
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".oos_detection.on_analysis_transition"
      />

</configure>
