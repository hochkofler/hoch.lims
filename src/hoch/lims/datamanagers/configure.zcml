<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="hoch.lims">

  <!-- HochRoutineAnalysisDataManager is registered in overrides.zcml (root)
       via <includeOverrides> to avoid ConfigurationConflictError with
       senaite.core's RoutineAnalysisDataManager registration. -->

  <!-- Dynamic Calculation: re-evaluate the rules when the sample is edited,
       e.g. a field set after sampling. The sample "Analyses" data manager is
       registered in overrides.zcml -->
  <subscriber
      for="bika.lims.interfaces.IAnalysisRequest
           Products.Archetypes.interfaces.IObjectEditedEvent"
      handler="hoch.lims.dynamiccalculation.on_sample_edited" />

</configure>
