<?xml version="1.0"?>
<rolemap>
  <!-- Roles deben tener 'name' y 'title' -->
  <roles>
    <role name="RegulatoryPharmacist"/>
  </roles>
  
  <permissions>
    <permission name="hoch.lims: Release Batch" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
      <role name="RegulatoryPharmacist"/>
    </permission>

    <permission name="hoch.lims: Field: Edit Extended Field" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
      <role name="LabClerk"/>
      <role name="Client"/>
    </permission>

    <!-- Cada permiso debe tener 'name' y 'acquire' -->
    <permission name="hoch.lims: Add MarketingAuthorization" acquire="False">
      <role name="Manager"/>
      <role name="RegulatoryPharmacist"/>
    </permission>
    
    <permission name="hoch.lims: Edit MarketingAuthorization" acquire="False">
      <role name="Manager"/>
      <role name="RegulatoryPharmacist"/>
    </permission>
    
    <permission name="hoch.lims: View MarketingAuthorization" acquire="True">
      <role name="Authenticated"/>
    </permission>
    
    <permission name="hoch.lims: Transition MarketingAuthorization" acquire="False">
      <role name="Manager"/>
      <role name="RegulatoryPharmacist"/>
    </permission>

    <permission name="senaite.core: Add Worksheet" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
      <role name="LabClerk"/>
    </permission>

    <permission name="senaite.core: Edit Worksheet" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
      <role name="LabClerk"/>
    </permission>

    <permission name="senaite.core: Manage Worksheets" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
      <role name="LabClerk"/>
    </permission>

    <!-- OOS Investigation permissions -->
    <permission name="hoch.lims: Add OOSInvestigation" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
    </permission>

    <permission name="hoch.lims: Edit OOSInvestigation" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
    </permission>

    <permission name="hoch.lims: View OOSInvestigation" acquire="True">
      <role name="Authenticated"/>
    </permission>

    <permission name="hoch.lims: Transition OOSInvestigation" acquire="False">
      <role name="Analyst"/>
      <role name="Manager"/>
      <role name="LabManager"/>
      <role name="RegulatoryPharmacist"/>
    </permission>

    <permission name="hoch.lims: Manage OOS Investigations" acquire="False">
      <role name="Manager"/>
      <role name="LabManager"/>
    </permission>
  </permissions>
</rolemap>
