<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="hoch.lims">

  <!-- Override senaite.core's RoutineAnalysisDataManager with our subclass
       that supports consumable fields. Must be in overrides.zcml (loaded via
       <includeOverrides>) to take precedence over the senaite.core registration. -->
  <adapter factory="hoch.lims.datamanagers.analysis.HochRoutineAnalysisDataManager" />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="senaite.core.vocabularies.resulttypes"
      component="hoch.lims.patches.time_support.TimeResultTypesVocabulary" />

</configure>
