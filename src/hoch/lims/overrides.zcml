<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="hoch.lims">

  <!-- Override senaite.core's RoutineAnalysisDataManager with our subclass
       that supports consumable fields. Must be in overrides.zcml (loaded via
       <includeOverrides>) to take precedence over the senaite.core registration. -->
  <adapter factory="hoch.lims.datamanagers.analysis.HochRoutineAnalysisDataManager" />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="senaite.core.vocabularies.resulttypes"
      component="hoch.lims.patches.time_support.TimeResultTypesVocabularyFactory" />

  <!-- Override senaite.core's "set_analysis_conditions" modal to fix numeric
       condition inputs missing step="any" (browsers default to step="1" and
       reject decimal values). See hoch.lims.browser.modals.conditions. -->
  <browser:page
      name="set_analysis_conditions"
      for="*"
      class="hoch.lims.browser.modals.conditions.SetAnalysisConditionsView"
      permission="senaite.core.permissions.FieldEditAnalysisConditions"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

</configure>
